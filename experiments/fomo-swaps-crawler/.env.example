# Free browser API: no FOMO credits, requires curl_cffi + Privy tokens.
# Credential files live under data/ so the systemd unit can rewrite them.
FOMO_API_BASE=https://prod-api.fomo.family
FOMO_AUTH_TOKEN_FILE=/opt/fomo-swaps-crawler/data/credentials/access_token
FOMO_REFRESH_TOKEN_FILE=/opt/fomo-swaps-crawler/data/credentials/refresh_token
FOMO_PRIVY_ORIGIN=https://fomo.family
FOMO_TOKEN_REFRESH_SKEW_SECONDS=300
FOMO_IMPERSONATE=chrome
FOMO_AUTH_RETRY_SECONDS=300

# Paid alternative (credits):
# FOMO_API_BASE=https://api.fomoapi.io
# FOMO_API_KEY=
# FOMO_CREDIT_COST=250
# FOMO_CREDIT_RESERVE=50000

FOMO_USERS_FILE=users.csv
FOMO_DATA_DIR=data
FOMO_INTERVAL_SECONDS=60
FOMO_MAX_INTERVAL_SECONDS=21600
FOMO_CONCURRENCY=4
FOMO_REQUEST_DELAY_MS=62
FOMO_BATCH_SIZE=20
FOMO_BATCH_PAUSE_SECONDS=0
FOMO_CYCLE_USERS=0
FOMO_TIMEOUT_SECONDS=30
FOMO_LIMIT=100
FOMO_MAX_USERS=0
FOMO_CREDIT_COST=0
FOMO_CREDIT_RESERVE=0
FOMO_MAX_503=0
FOMO_CLEAN_CYCLES_TO_DECAY=8
FOMO_START_DELAY_SECONDS=0
FOMO_LOG_LEVEL=INFO
