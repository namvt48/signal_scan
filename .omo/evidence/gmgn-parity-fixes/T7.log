Solana wallet swap-step watcher (GMGN row parity)

options:
  -h, --help            show this help message and exit
  --wallets WALLETS
  --quotes QUOTES
  --interval INTERVAL   giữa các nhịp, mode poll
  --sweep SWEEP         mode ws: khoảng cách quét lưới-an-toàn (giây), chống
                        sót tx không mention ví
  --backfill BACKFILL   log N tx cũ cho ví chưa có state
  --once
  --min-usd MIN_USD
  --show-fail           in cả dòng FAILED cho tx lỗi (spam sniper, như tab đỏ
                        GMGN)
  --jsonl JSONL         ghi thêm mỗi sự kiện 1 dòng JSON vào file này (log
                        machine-readable)
  --api-url API_URL     base URL của alpha-engine API (dùng cho --track)
  --track               tự POST CA của mọi tx BUY/SELL vào API để auto-add
                        tracking (mặc định tắt)
  --feed {block,ws,poll}
                        block: quét getBlock mỗi slot confirmed (mặc định) |
                        ws: node push theo block | poll: hẹn giờ HTTP
  --block-backfill BLOCK_BACKFILL
                        feed block: cold start lùi N slot sau getSlot
                        confirmed
  --block-max-lag BLOCK_MAX_LAG
                        feed block: lag vượt ngưỡng thì in gap và nhảy tới
                        cur-max_lag
  --block-save-every BLOCK_SAVE_EVERY
                        feed block: save_state mỗi N slot
  --block-sleep BLOCK_SLEEP
                        feed block: sleep giữa các slot (giây)
  --rpc-url RPC_URL     endpoint RPC HTTP; mặc định đọc env SOLANA_RPC_URL →
                        RPC_HTTP → list có sẵn

