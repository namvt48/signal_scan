# Firebase web config — public client identifiers (they ship in the bundle by
# design). Copy to .env and fill in; role authorization lives server-side.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=

# FOMO prod bridge: Privy app id from the fomo.family session. Public client
# identifier, but keep it in .env so the bridge can refresh the access token.
FOMO_PRIVY_APP_ID=

# FOMO upstream is fail-closed. `limited` requires positive per-window budgets;
# `unlimited` bypasses only quota windows, not 403 suspension or 429 cooldown.
# Do not enable upstream on a suspended account. Guard state lives under
# DATA_DIR/fomo-prod-guard.
FOMO_UPSTREAM_ENABLED=false
FOMO_REQUEST_QUOTA_MODE=limited
FOMO_MAX_REQUESTS_PER_MINUTE=0
FOMO_MAX_REQUESTS_PER_HOUR=0
FOMO_MAX_REQUESTS_PER_DAY=0
FOMO_REQUEST_DELAY_MS=1000
FOMO_CONCURRENCY=1


# Optional FOMO following sync. Enable only on the FOMO instance (B).
FOMO_ALITA_SYNC=off
FOMO_ALITA_USER_ID=2c43be94-b528-5fe2-9dc3-27837e009cc8
FOMO_ALITA_POLL_MS=900000
FOMO_ALITA_TAG=Alita follow
