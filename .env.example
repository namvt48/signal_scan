# Firebase web config — public client identifiers (they ship in the bundle by
# design). Copy to .env and fill in; role authorization lives server-side.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=

# FOMO prod bridge: Privy app id from the fomo.family session. Public client
# identifier, but keep it in .env so the bridge can refresh the access token.
FOMO_PRIVY_APP_ID=
