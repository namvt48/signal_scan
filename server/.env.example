# signal_scan API — copy to server/.env and adjust. Every var below is read by
# server/src/config.ts. Missing values fall back to the defaults shown here.

# Provider mode: nansen (all live data — default) | mock (deterministic pipeline
# demo, seeds sample data). MODE=gmgn is a retired NO-OP → runs as nansen.
MODE=nansen

# HTTP port the API listens on INSIDE the container/host.
# Docker: nginx proxies /api/ -> api:3001, so leave 3001 in compose deployments.
PORT=3001

# SQLite file path (directory is created on start). Docker compose mounts /data.
DB_PATH=./data/signal_scan.db

# --- Sweep cadences (milliseconds) --------------------------------------------
# ONE knob per endpoint family (free app-questions via the browser transport).
# Pacing: each sweep spreads its requests over SWEEP_PACE_FACTOR of its interval,
# so a shorter interval only tightens the gap (Cloudflare 403/429 risk).
# BUDGET: every free app-question shares ONE browser page = ~43 req/min measured
# (2026-09-16). Keep Σ n/(interval×pace) under it, or raise SWEEP_PACE_FACTOR.
# essential-data: deployed_at + supply (LF denominator) — write-once, 1 pass.
POLL_ESSENTIAL_MS=86400000
# volume-details: 24H Volume column + the Entry gate.
POLL_VOLUME_MS=3600000
# The two expensive sweeps (gini: Fresh%/T100%/median — the Holder column
# primary; hourly-stats top_100: T100 genesis pair + Bal 24H/7D/30D + chart
# cache) run in TWO tiers split by 24H volume:
#   hot  = volume24h >= HOT_VOLUME_USD  -> POLL_HOT_MS
#   cold = the rest                     -> POLL_COLD_MS
# holders-change is no longer swept: gini's totalHolders is the same Holder
# column value (signals.ts: nansen_holders ?? holders) for one request less.
# At 112 hot CAs a 15m tier measured ~97% of its interval — raise the gate or
# this interval when the ">80% of its interval" ceiling warn appears.
HOT_VOLUME_USD=500000
POLL_HOT_MS=900000
POLL_COLD_MS=14400000
# Retries inside ONE essential pass (the only source of supply/deployed_at).
ESSENTIAL_RETRIES=3
# Symbol floor: ONE Solana RPC getAsset per ticker-less CA — no browser door, so
# tickers still fill while Cloudflare/sidecar blocks the app-questions.
POLL_SYMBOL_BACKFILL_MS=300000
# Wallet sweep (official credit API): dexTrades 1cr/wallet + current-balance
# 1cr per (wallet, tracked CA). Skipped with a warn when NANSEN_API_KEY is absent.
POLL_WALLETS_MS=900000
# Spread each sweep's requests across this fraction of its interval (0.1-1).
SWEEP_PACE_FACTOR=0.8

# --- Nansen transport & credentials -------------------------------------------
# Chart-cache sweep gate: on = crawl hourly-stats through the browser sidecar.
NANSEN_CRAWL=on
# browserless CDP endpoint — app-questions only work from a real browser context
# (Cloudflare blocks non-browser TLS with 403).
CRAWL_WS_ENDPOINT=ws://chrome:3000
# Browser circuit breaker: after N consecutive THROWN transport failures the door
# fast-fails for the cooldown instead of burning 30-45s per CA per retry.
CRAWL_BREAKER_FAILURES=5
CRAWL_BREAKER_COOLDOWN_MS=60000
# Official API key (credit door): wallet trades + per-CA balances. Empty = free
# token metrics still run, wallet sweep skips.
NANSEN_API_KEY=
# Mốc backfill lịch sử trades (ISO date) cho Tracked Inflow
NANSEN_BACKFILL_FROM=2026-08-01

# --- Door pool / proxy routing ------------------------------------------------
# Multi-IP door pool: one browserless connection per proxy, so each door keeps its
# own cookie jar + cf_clearance + egress IP. File missing/empty → single door from
# CRAWL_WS_ENDPOINT (the previous behaviour). File is read ONCE at boot — changing
# it needs `make restart` (no hot reload).
# Proxy file: one line per proxy, format http://user:pass@host:port
#   (no socks5 — Chrome cannot authenticate SOCKS5 over CDP). Blank lines and
#   lines starting with # are skipped; an unparseable line is warned + skipped.
# Put the list at ./data/proxies.txt — ./data is bind-mounted, and the file must
# NEVER be committed (contains proxy credentials). Empty = single-door fallback.
CRAWL_PROXY_FILE=
# Per-(door,path) sliding-window budget: max requests to one path per window.
CRAWL_PATH_BUDGET=30
CRAWL_BUDGET_WINDOW_MS=60000
# Total requests per door per minute (measured page ceiling is ~43/min).
CRAWL_DOOR_CAP_PER_MIN=40
# Cloudflare warmup: wait for title != "Just a moment" + cf_clearance cookie.
CRAWL_WARMUP_TIMEOUT_MS=30000
# One in-page fetch timeout; a thrown timeout counts as a transport failure.
CRAWL_REQUEST_TIMEOUT_MS=45000
# Max random jitter added on top of a 429 retry-after quarantine.
CRAWL_QUARANTINE_JITTER_MS=30000

# Cadence repair (D12, owner-approved): the door-pool sizing assumes ~32 req/min
# total. With the current prod cadences (~190 req/min) the pool needs >=6 dedicated
# IPs; with these repair values ONE door (2-3 recommended for headroom) suffices.
# These are prod-server .env values — they do NOT change the config.ts defaults:
#   POLL_WALLETS_MS=5400000
#   POLL_HOT_MS=1800000
#   POLL_COLD_MS=7200000

# SECURITY: NANSEN_API_KEY was exposed — rotate it before the next deploy, then
# update the prod-server .env by hand (the Makefile does not copy .env).

# --- Retention & windows (ms) -------------------------------------------------
# Holder snapshots older than this are pruned.
SNAPSHOT_RETENTION_MS=259200000
# trackedBy: wallets with a buy within this window still count (default 7 days).
TRACKED_BY_WINDOW_MS=604800000
# T100 pairing: "previous" snapshot = newest one at least this old (default 24h).
T100_WINDOW_MS=86400000

# --- Auth (AUTH CONTRACT v1 — src/auth.ts) -------------------------------------
# All three are FAIL CLOSED when empty: no FIREBASE_PROJECT_ID → browser tokens
# rejected; no AUTH_USER_ROLES → nobody is admin/viewer; no SERVICE_TOKEN → the
# daemon path is disabled. Every route except GET /api/health requires a Bearer token.
# Firebase project whose Google ID tokens are accepted (verified against Firebase's
# PUBLIC JWKS — no service-account key on this server).
FIREBASE_PROJECT_ID=trading-auth-67772
# Comma-separated email:role pairs — roles admin|viewer, emails case-insensitive,
# unknown role strings ignored, duplicate email → last wins. The 'service' role is
# NOT assignable here (it exists only via SERVICE_TOKEN).
AUTH_USER_ROLES=you@example.com:admin
# Static Bearer token for the wallet_watch daemon (role 'service'): may POST
# /api/tracked-cas + /api/wallet-watch/trades and GET /api/wallets + /api/settings,
# nothing else. Generate a long random secret, e.g. `openssl rand -hex 32`.
SERVICE_TOKEN=

# --- Nansen factor PASS thresholds (placeholders awaiting T's sign-off) -------
# Fresh Wallet: fresh% >= FRESH_MIN_PCT passes.
FRESH_MIN_PCT=10
# Top100 Decrease: t100 pct >= T100_MIN_PCT passes.
T100_MIN_PCT=5
# Low Float: genesis top-100 cohort share (genesis_bal/supply × 100) <= LF_MAX_PCT
# passes — low float = whales control <30% of supply at listing, less coordinated
# dump fuel. (Old $M market-cap bucket LF_MIN/LF_MAX deleted 2026-09-10.)
LF_MAX_PCT=30
# Entry-size gate: tracked CAs with entry_usd below this (or NULL) are skipped
# by /api/signals. USD, not percent — values >100 are valid.
MIN_USD=50
